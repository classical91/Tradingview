//@version=5
indicator("Local Top / Bottom Screener v1", overlay=true, max_labels_count=100)

webhookSecret = input.string("", "Webhook secret")
bbLength = input.int(20, "Bollinger length", minval=5)
bbMultiplier = input.float(2.0, "Bollinger multiplier", minval=0.5, step=0.1)
rsiLength = input.int(14, "RSI length", minval=2)
emaLength = input.int(200, "Regime EMA length", minval=20)
volumeLength = input.int(20, "Volume average length", minval=2)
volumeSpikeThreshold = input.float(1.5, "Volume spike ratio", minval=1.0, step=0.1)
pivotLeft = input.int(3, "Pivot bars left", minval=1)
pivotRight = input.int(3, "Pivot bars right", minval=1)
showCandidateLabels = input.bool(true, "Show candidate labels")

basis = ta.sma(close, bbLength)
deviation = ta.stdev(close, bbLength)
bbUpper = basis + bbMultiplier * deviation
bbLower = basis - bbMultiplier * deviation
bbZScore = deviation == 0 ? 0 : (close - basis) / deviation
rsiValue = ta.rsi(close, rsiLength)
ema200 = ta.ema(close, emaLength)
atrValue = ta.atr(14)
volumeAverage = ta.sma(volume, volumeLength)[1]
volumeRatio = volumeAverage > 0 ? volume / volumeAverage : 0

pivotLow = ta.pivotlow(low, pivotLeft, pivotRight)
pivotHigh = ta.pivothigh(high, pivotLeft, pivotRight)
pivotLowRsi = not na(pivotLow) ? rsiValue[pivotRight] : na
pivotHighRsi = not na(pivotHigh) ? rsiValue[pivotRight] : na

latestSwingLow = ta.valuewhen(not na(pivotLow), pivotLow, 0)
previousSwingLow = ta.valuewhen(not na(pivotLow), pivotLow, 1)
latestLowRsi = ta.valuewhen(not na(pivotLowRsi), pivotLowRsi, 0)
previousLowRsi = ta.valuewhen(not na(pivotLowRsi), pivotLowRsi, 1)
latestSwingHigh = ta.valuewhen(not na(pivotHigh), pivotHigh, 0)
previousSwingHigh = ta.valuewhen(not na(pivotHigh), pivotHigh, 1)
latestHighRsi = ta.valuewhen(not na(pivotHighRsi), pivotHighRsi, 0)
previousHighRsi = ta.valuewhen(not na(pivotHighRsi), pivotHighRsi, 1)

regularBullishDivergence = not na(previousSwingLow) and latestSwingLow < previousSwingLow and latestLowRsi > previousLowRsi + 2
regularBearishDivergence = not na(previousSwingHigh) and latestSwingHigh > previousSwingHigh and latestHighRsi < previousHighRsi - 2
liquiditySweepLow = not na(latestSwingLow) and low < latestSwingLow and close > latestSwingLow
liquiditySweepHigh = not na(latestSwingHigh) and high > latestSwingHigh and close < latestSwingHigh
volumeSpike = volumeRatio >= volumeSpikeThreshold
bullishConfirmation = ta.crossover(close, bbLower) or close > high[1]
bearishConfirmation = ta.crossunder(close, bbUpper) or close < low[1]

bottomLocation = low <= bbLower or bbZScore <= -2
topLocation = high >= bbUpper or bbZScore >= 2
bottomMomentum = rsiValue <= 30
topMomentum = rsiValue >= 70

bottomScore = (bottomLocation ? 15 : 0) + (bottomMomentum ? 10 : 0) + (regularBullishDivergence ? 20 : 0) + (liquiditySweepLow ? 20 : 0) + (volumeSpike ? 15 : 0) + (bullishConfirmation ? 20 : 0)
topScore = (topLocation ? 15 : 0) + (topMomentum ? 10 : 0) + (regularBearishDivergence ? 20 : 0) + (liquiditySweepHigh ? 20 : 0) + (volumeSpike ? 15 : 0) + (bearishConfirmation ? 20 : 0)

stateFromScore(_score, _confirmed) =>
    _score < 40 ? "NONE" : _score < 60 ? "WATCH" : not _confirmed ? "CANDIDATE" : _score < 85 ? "CONFIRMING" : "CONFIRMED"

bottomState = stateFromScore(bottomScore, bullishConfirmation)
topState = stateFromScore(topScore, bearishConfirmation)
direction = bottomScore > topScore ? "BOTTOM" : topScore > bottomScore ? "TOP" : "NEUTRAL"
state = direction == "BOTTOM" ? bottomState : direction == "TOP" ? topState : "NONE"
regime = close >= ema200 ? "BULLISH" : "BEARISH"

addReason(_json, _active, _reason) =>
    _active ? _json + (str.length(_json) > 1 ? "," : "") + "\"" + _reason + "\"" : _json

bottomReasons = "["
bottomReasons := addReason(bottomReasons, bottomLocation, "lower_bb")
bottomReasons := addReason(bottomReasons, bottomMomentum, "rsi_oversold")
bottomReasons := addReason(bottomReasons, regularBullishDivergence, "regular_bullish_divergence")
bottomReasons := addReason(bottomReasons, liquiditySweepLow, "swing_low_sweep")
bottomReasons := addReason(bottomReasons, volumeSpike, "volume_spike")
bottomReasons := addReason(bottomReasons, bullishConfirmation, "bullish_structure_reclaim") + "]"

topReasons = "["
topReasons := addReason(topReasons, topLocation, "upper_bb")
topReasons := addReason(topReasons, topMomentum, "rsi_overbought")
topReasons := addReason(topReasons, regularBearishDivergence, "regular_bearish_divergence")
topReasons := addReason(topReasons, liquiditySweepHigh, "swing_high_sweep")
topReasons := addReason(topReasons, volumeSpike, "volume_spike")
topReasons := addReason(topReasons, bearishConfirmation, "bearish_structure_rejection") + "]"

selectedReasons = direction == "BOTTOM" ? bottomReasons : direction == "TOP" ? topReasons : "[]"
signalName = direction == "BOTTOM" ? "local_bottom_" + str.lower(state) : direction == "TOP" ? "local_top_" + str.lower(state) : "none"

formatJson() =>
    "{" +
      "\"secret\":\"" + webhookSecret + "\"," +
      "\"ticker\":\"" + syminfo.ticker + "\"," +
      "\"timeframe\":\"" + timeframe.period + "\"," +
      "\"price\":" + str.tostring(close, format.mintick) + "," +
      "\"signal\":\"" + signalName + "\"," +
      "\"bottomScore\":" + str.tostring(bottomScore) + "," +
      "\"topScore\":" + str.tostring(topScore) + "," +
      "\"state\":\"" + state + "\"," +
      "\"direction\":\"" + direction + "\"," +
      "\"reasons\":" + selectedReasons + "," +
      "\"rsi\":" + str.tostring(rsiValue, "#.##") + "," +
      "\"bbZScore\":" + str.tostring(bbZScore, "#.###") + "," +
      "\"ema200\":" + str.tostring(ema200, format.mintick) + "," +
      "\"atr\":" + str.tostring(atrValue, format.mintick) + "," +
      "\"volume\":" + str.tostring(volume, "#.##") + "," +
      "\"volumeSma\":" + str.tostring(volumeAverage, "#.##") + "," +
      "\"volumeRatio\":" + str.tostring(volumeRatio, "#.###") + "," +
      "\"regime\":\"" + regime + "\"," +
      "\"message\":\"" + syminfo.ticker + " " + direction + " " + state + " (" + str.tostring(math.max(bottomScore, topScore)) + "/100)\"," +
      "\"timestamp\":\"" + str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + "\"" +
    "}"

actionableState = state == "CANDIDATE" or state == "CONFIRMING" or state == "CONFIRMED"
newActionableState = barstate.isconfirmed and actionableState and (state != state[1] or direction != direction[1])

if newActionableState
    alert(formatJson(), alert.freq_once_per_bar_close)

bottomCandidate = direction == "BOTTOM" and state == "CANDIDATE"
topCandidate = direction == "TOP" and state == "CANDIDATE"
bottomConfirmed = direction == "BOTTOM" and state == "CONFIRMED"
topConfirmed = direction == "TOP" and state == "CONFIRMED"

if showCandidateLabels and bottomCandidate and not bottomCandidate[1]
    label.new(bar_index, low, "BOTTOM CANDIDATE\n" + str.tostring(bottomScore) + "/100", style=label.style_label_up, color=color.new(color.teal, 15), textcolor=color.white)
if showCandidateLabels and topCandidate and not topCandidate[1]
    label.new(bar_index, high, "TOP CANDIDATE\n" + str.tostring(topScore) + "/100", style=label.style_label_down, color=color.new(color.orange, 15), textcolor=color.white)
if bottomConfirmed and not bottomConfirmed[1]
    label.new(bar_index, low, "BOTTOM CONFIRMED\n" + str.tostring(bottomScore) + "/100", style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white)
if topConfirmed and not topConfirmed[1]
    label.new(bar_index, high, "TOP CONFIRMED\n" + str.tostring(topScore) + "/100", style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white)

plot(bbUpper, "BB upper", color=color.new(color.gray, 45))
plot(basis, "BB basis", color=color.new(color.blue, 60))
plot(bbLower, "BB lower", color=color.new(color.gray, 45))
plot(ema200, "EMA 200", color=color.new(color.yellow, 20), linewidth=2)
plotshape(liquiditySweepLow, "Swing low sweep", shape.circle, location.belowbar, color=color.teal, size=size.tiny)
plotshape(liquiditySweepHigh, "Swing high sweep", shape.circle, location.abovebar, color=color.orange, size=size.tiny)

var table scoreTable = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 20), frame_color=color.new(color.gray, 60), frame_width=1)
if barstate.islast
    table.cell(scoreTable, 0, 0, "Local Bottom", text_color=color.silver)
    table.cell(scoreTable, 1, 0, str.tostring(bottomScore) + "/100", text_color=color.teal)
    table.cell(scoreTable, 0, 1, "Local Top", text_color=color.silver)
    table.cell(scoreTable, 1, 1, str.tostring(topScore) + "/100", text_color=color.orange)
    table.cell(scoreTable, 0, 2, "State", text_color=color.silver)
    table.cell(scoreTable, 1, 2, state, text_color=color.white)
    table.cell(scoreTable, 0, 3, "Regime", text_color=color.silver)
    table.cell(scoreTable, 1, 3, regime, text_color=regime == "BULLISH" ? color.green : color.red)
